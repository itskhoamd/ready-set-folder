# --- ready-set-folder: keep secrets and junk out of git ---
# Secrets
.env
*.env
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# Never commit what's waiting to be deleted
_system/_to_delete/*
!_system/_to_delete/README.md

# System junk
.DS_Store
._*
Thumbs.db
desktop.ini

# Tools
node_modules/
__pycache__/
.venv/

# --- film-production: people's data and receipts never go into a shared or public copy ---
jobs/*
!jobs/README.md
!jobs/_JOB-TEMPLATE/
portfolio/bts/*
!portfolio/bts/README.md
